--| `nop` advances RIP by one and changes nothing else.
theorem test_nop {k2: nat} (k rip r: nat)
  (hk:   $ k e. Config $)
  (hex:  $ readException k = 0 $)
  (hc:   $ readMemX k (readRIP k) (s1 (ch x9 x0)) $)
  (hrip: $ readRIP k = rip $):
  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 1 /\
      readReg k2 r = readReg k r /\
      readFlags k2 = readFlags k) $;

--| `stc` sets CF, leaves the other flags and all registers alone, and
--| advances RIP by one.
theorem test_stc {k2: nat} (k rip r: nat)
  (hk:   $ k e. Config $)
  (hex:  $ readException k = 0 $)
  (hc:   $ readMemX k (readRIP k) (s1 (ch xf x9)) $)
  (hrip: $ readRIP k = rip $):
  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 1 /\
      readReg k2 r = readReg k r /\
      CF (readFlags k2) /\
      (ZF (readFlags k2) <-> ZF (readFlags k)) /\
      (SF (readFlags k2) <-> SF (readFlags k)) /\
      (OF (readFlags k2) <-> OF (readFlags k))) $;

--| `inc rax` with `rax = -1`: the result is zero, so `ZF` is set and `SF`
--| clear; there is a carry out but no signed overflow, and `inc` discards the
--| carry -- `CF` comes back exactly as it went in.
