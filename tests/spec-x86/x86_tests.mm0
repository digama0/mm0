  (hk:   $ k e. Config $)
  (hex:  $ readException k = 0 $)
  (hc:   $ readMemX k (readRIP k) (ch x4 x8 ': ch x3 x3 ': s1 (ch xc x1)) $)
  (hrip: $ readRIP k = rip $)
  (hrax: $ readReg k RAX = xf :x xf :x x0 :x x0 :x xf :x xf :x x0 :x x0 :x xf :x xf :x x0 :x x0 :x xf :x xf :x x0 :x x0 $)
  (hrcx: $ readReg k RCX = xf :x xf :x x0 :x x0 :x xf :x xf :x x0 :x x0 :x xf :x xf :x x0 :x x0 :x xf :x xf $):
  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 3 /\
      readReg k2 RAX = xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf /\
      ~CF (readFlags k2) /\
      ~ZF (readFlags k2) /\
      SF (readFlags k2) /\
      ~OF (readFlags k2)) $;

--| `neg rax` at `INT_MIN`.  The *only* operand at which `neg` sets OF, and
--| what makes the model's `MSB a /\ MSB (-a)` the right formula rather than a
--| suspicious-looking conjunction: `INT_MIN` is the fixed point of negation,
--| so it is the one value whose negation keeps the sign bit.
theorem test_neg_rax_intmin {k2: nat} (k rip: nat)
  (hk:   $ k e. Config $)
  (hex:  $ readException k = 0 $)
  (hc:   $ readMemX k (readRIP k) (ch x4 x8 ': ch xf x7 ': s1 (ch xd x8)) $)
  (hrip: $ readRIP k = rip $)
  (hrax: $ readReg k RAX = x8 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 $):
  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 3 /\
      readReg k2 RAX = x8 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 /\
      CF (readFlags k2) /\
      ~ZF (readFlags k2) /\
      SF (readFlags k2) /\
      OF (readFlags k2)) $;

--| `add eax, ecx` at 32 bits, which does two things at once, both the shape
--| of bugs the audit already found: the operands are *truncated* to 32 bits
--| before the addition, and the result goes back through `writeReg32`, a full
--| `setReg` -- so the upper half of `rax` is **cleared**, not preserved.  The
--| flags are the 32 bit boundary: `INT_MAX + 1` sets OF but leaves CF clear,
--| since it does not carry out of 32 bits.
theorem test_add_eax_ecx {k2: nat} (k rip: nat)
  (hk:   $ k e. Config $)
  (hex:  $ readException k = 0 $)
  (hc:   $ readMemX k (readRIP k) (ch x0 x3 ': s1 (ch xc x1)) $)
  (hrip: $ readRIP k = rip $)
  (hrax: $ readReg k RAX = xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x x7 :x xf :x xf :x xf :x xf :x xf :x xf :x xf $)
  (hrcx: $ readReg k RCX = xf :x xf :x xf :x xf :x xf :x xf :x xf :x xf :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x1 $):
  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 2 /\
      readReg k2 RAX = x8 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 /\
      ~CF (readFlags k2) /\
      ~ZF (readFlags k2) /\
      SF (readFlags k2) /\
      OF (readFlags k2)) $;

--| `mul rcx` with `rax = rcx = 2^32`: the product is exactly `2^64`, so `rax`
--| comes back zero, `rdx` one, and CF and OF are set because the result does
--| not fit in the destination.  Regression test for the audit finding that
--| the model left `mul`'s flags untouched -- before the fix `CF (readFlags
--| k2)` was not provable at all, while the hardware sets it.  Only CF and OF
--| are asserted: `eraseFlags` leaves ZF and SF genuinely unconstrained, which
--| is right, since the SDM calls them undefined.
theorem test_mul_rcx {k2: nat} (k rip: nat)
  (hk:   $ k e. Config $)
  (hex:  $ readException k = 0 $)
  (hc:   $ readMemX k (readRIP k) (ch x4 x8 ': ch xf x7 ': s1 (ch xe x1)) $)
  (hrip: $ readRIP k = rip $)
  (hrax: $ readReg k RAX = x1 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 $)
  (hrcx: $ readReg k RCX = x1 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 :x x0 $):
  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 3 /\
      readReg k2 RAX = x0 /\
      readReg k2 RDX = x1 /\
      CF (readFlags k2) /\
      OF (readFlags k2)) $;

--| `lea rax, [0x12345678]` with REX.B set.  The prefix addresses nothing: a
--| SIB base field of `101` with `mod=00` is disp32-with-no-base whatever
--| REX.B says, which is the behaviour audit finding A6 corrected -- pre-fix
--| the model read these bytes as `[r13]` and consumed four rather than eight,
--| so both the result and the instruction length would be wrong.  `lea`
--| computes the address without dereferencing it, so this needs no mapped
--| memory.
theorem test_lea_rax_abs {k2: nat} (k rip: nat)
  (hk:   $ k e. Config $)
  (hex:  $ readException k = 0 $)
  (hc:   $ readMemX k (readRIP k) (ch x4 x9 ': ch x8 xd ': ch x0 x4 ': ch x2 x5 ': ch x7 x8 ': ch x5 x6 ': ch x3 x4 ': s1 (ch x1 x2)) $)
  (hrip: $ readRIP k = rip $):
  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 8 /\
      readReg k2 RAX = x1 :x x2 :x x3 :x x4 :x x5 :x x6 :x x7 :x x8 /\
      readFlags k2 = readFlags k) $;
