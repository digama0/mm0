  $ E. k2 (step k k2 /\
      readRIP k2 = rip +_64 3 /\
      readReg k2 RAX = x0 /\
      (CF (readFlags k2) <-> CF (readFlags k)) /\
      ZF (readFlags k2) /\
      ~SF (readFlags k2) /\
      ~OF (readFlags k2)) $;

