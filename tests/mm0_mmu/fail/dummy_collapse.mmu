(sort wff strict provable)
(sort set)
(term wn ((a wff ())) (wff ()))
(term wal ((x set) (a wff (x))) (wff ()))
(term weq ((a set ()) (b set ())) (wff ()))
(axiom two ((x set) (y set)) () (wn (wal x (wal y (weq x y)))))
(axiom refl ((x set)) () (wal x (wal x (weq x x))))
(def f () (wff ()) ((d1 set) (d2 set)) (wal d1 (wal d2 (weq d1 d2))))
(theorem foo () () (wn (f)) ((a set) (b set))
  (:conv (wn (f)) (wn (:unfold f () (a b) (wal a (wal b (weq a b)))))
    (two (a b))))
