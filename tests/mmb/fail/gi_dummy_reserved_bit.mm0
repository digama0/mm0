-- Regression test for https://github.com/digama0/mm0/issues/207, reported by
-- @gleachkr: mm0-c allowed a 56th bound variable, whose dependency bit is the
-- reserved bit 55 of a type word and is therefore masked off everywhere the
-- verifier consults dependencies.
--
-- The `step` applications below bind the first 55 dummies, and `project` then
-- projects onto x55, so the body of `choose` has x55 free and `choose` is not
-- a legal definition. With the off-by-one, x55's dependency bit vanished under
-- TYPE_DEPS_MASK and `choose` was accepted as closed, after which the `seed`
-- axiom proves `pred x` for an arbitrary bound variable x.
--
-- mm0-rs rejects this source (more than 55 bound variables), so the .mmb next
-- to this file is hand-written and cannot be regenerated with `mm0-rs compile`.
delimiter $ + ? $;
sort s;
provable sort wff;
term base: s;
term step (a: s) {b: s}: s; infixl step: $+$ prec 1;
def project (a b: s): s = $ b $; infixl project: $?$ prec 0;
def choose
  (.x00 .x01 .x02 .x03 .x04 .x05 .x06 .x07
   .x08 .x09 .x10 .x11 .x12 .x13 .x14 .x15
   .x16 .x17 .x18 .x19 .x20 .x21 .x22 .x23
   .x24 .x25 .x26 .x27 .x28 .x29 .x30 .x31
   .x32 .x33 .x34 .x35 .x36 .x37 .x38 .x39
   .x40 .x41 .x42 .x43 .x44 .x45 .x46 .x47
   .x48 .x49 .x50 .x51 .x52 .x53 .x54 .x55: s): s =
  $ base + x00 + x01 + x02 + x03 + x04 + x05 + x06 + x07 +
    x08 + x09 + x10 + x11 + x12 + x13 + x14 + x15 +
    x16 + x17 + x18 + x19 + x20 + x21 + x22 + x23 +
    x24 + x25 + x26 + x27 + x28 + x29 + x30 + x31 +
    x32 + x33 + x34 + x35 + x36 + x37 + x38 + x39 +
    x40 + x41 + x42 + x43 + x44 + x45 + x46 + x47 +
    x48 + x49 + x50 + x51 + x52 + x53 + x54 ? x55 $;
term pred (a: s): wff;
axiom seed: $ pred choose $;
theorem bad {x: s}: $ pred x $;
